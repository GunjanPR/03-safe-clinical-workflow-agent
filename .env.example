# Copy to .env (git-ignored). All variables are optional; defaults shown.
# Compact store built by `make data` (SQLite) or a PostgreSQL URL after `make pg-load`.
CLINAGENT_DATABASE_URL=sqlite:///data/clinical.db
# Read charts from HAPI FHIR instead of the store (writes still go to the SQL store).
CLINAGENT_FHIR_BASE_URL=
# OpenAI-compatible endpoint for the LLM parser. Empty = deterministic parser only.
CLINAGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
CLINAGENT_LLM_MODEL=llama3.2
CLINAGENT_LLM_API_KEY=not-needed
# HMAC key for clinician approval tokens (set a long random value outside local dev).
CLINAGENT_APPROVAL_SECRET=
CLINAGENT_APPROVAL_TTL_S=900
# Recommendations below this confidence go to a pharmacist instead of a proposal.
CLINAGENT_MIN_CONFIDENCE=0.55
CLINAGENT_AUDIT_PATH=data/audit.jsonl
# none | console | otlp (otlp uses OTEL_EXPORTER_OTLP_ENDPOINT, e.g. http://127.0.0.1:4319)
CLINAGENT_OTEL_EXPORTER=none
